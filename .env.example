# ==============================================================================
# BATTVISION WORKSTATION ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env and adjust as necessary for local bench deployment.
# ==============================================================================

# Frontend (Vite) API Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend (FastAPI) Host & Port
BV_HOST=0.0.0.0
BV_PORT=8000

# Backend Storage Paths (Relative to project root or absolute paths)
BV_DATABASE_PATH=data/telemetry/battvision.db
BV_MODELS_DIR=data/models
BV_EXPORTS_DIR=data/exports

# Hardware & Serial Transport Configuration (Pending Physical Hardware Bench)
BV_SERIAL_PORT=/dev/ttyUSB0
BV_SERIAL_BAUD=115200
