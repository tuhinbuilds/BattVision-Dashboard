[Unit]
Description=BattVision Offline Edge Backend (FastAPI + SQLite + Dashboard Host)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/battvision/backend
Environment="BV_HOST=0.0.0.0"
Environment="BV_PORT=8000"
Environment="BV_DATABASE_PATH=/opt/battvision/data/telemetry/battvision.db"
ExecStart=/opt/battvision/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
